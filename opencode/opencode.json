{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@cortexkit/opencode-magic-context@0.37.0",
    "context-mode",
    "commandcode-go-opencode-provider/server"
  ],
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "notionApi": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "enabled": true,
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      }
    },
    "FigmaDesktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    }
  },
  "provider": {
    "commandcode": {
      "npm": "commandcode-go-opencode-provider",
      "name": "Command Code",
      "env": ["COMMANDCODE_API_KEY"]
    },
    "opencodex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCodex",
      "options": {
        "baseURL": "http://127.0.0.1:10100/v1",
        "apiKey": "{env:OPENCODEX_API_KEY}"
      },
      "models": {
        "anthropic/claude-haiku-5-5": {
          "name": "claude-haiku-5-5 (anthropic)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "anthropic/claude-opus-5-5": {
          "name": "claude-opus-5-5 (anthropic)",
          "limit": {
            "context": 350000,
