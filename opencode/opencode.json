          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol (native)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "opencode-zen/big-pickle": {
