{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@cortexkit/opencode-magic-context@0.37.0",
    "context-mode",
    "commandcode-go-opencode-provider/server"
  ],
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "notionApi": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "enabled": true,
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      }
    },
    "FigmaDesktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    }
  },
  "provider": {
    "commandcode": {
      "npm": "commandcode-go-opencode-provider",
      "name": "Command Code",
      "env": ["COMMANDCODE_API_KEY"]
    },
    "opencodex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCodex",
      "options": {
        "baseURL": "http://127.0.0.1:10100/v1",
        "apiKey": "{env:OPENCODEX_API_KEY}"
      },
      "models": {
        "anthropic/claude-fable-5": {
          "name": "claude-fable-5 (anthropic)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "anthropic/claude-opus-5": {
          "name": "claude-opus-5 (anthropic)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "anthropic/claude-sonnet-5": {
          "name": "claude-sonnet-5 (anthropic)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "combo/sp-code-review": {
          "name": "sp-code-review (combo)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "combo/sp-debug": {
          "name": "sp-debug (combo)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "combo/sp-spec-review": {
          "name": "sp-spec-review (combo)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "combo/sp-worker": {
          "name": "sp-worker (combo)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "combo/sp-worker-pro": {
          "name": "sp-worker-pro (combo)",
          "limit": {
            "context": 350000,
            "output": 32000
          }
        },
        "command-code/deepseek-deepseek-v4-flash": {
          "name": "deepseek/deepseek-v4-flash (command-code)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "command-code/deepseek-deepseek-v4-flash-vision-exp": {
          "name": "deepseek/deepseek-v4-flash-vision-exp (command-code)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "command-code/minimax-minimax-m2.7-free": {
          "name": "minimax/minimax-m2.7-free (command-code)",
          "limit": {
            "context": 197000,
            "output": 32000
          }
        },
        "command-code/minimax-minimax-m3-free": {
          "name": "minimax/minimax-m3-free (command-code)",
          "limit": {
            "context": 1000000,
            "output": 32000
          }
        },
        "command-code/stealth-ox-alpha": {
          "name": "stealth/ox-alpha (command-code)",
          "limit": {
            "context": 1048576,
            "output": 32000
          }
        },
        "google-antigravity/claude-opus-4-6-thinking": {
